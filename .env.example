# ───────────────────────────────────────────────────────────────
# FreelanceOS environment configuration
# Copy to ".env" and fill in. NOTHING here is required to run the app
# locally with sample data — every integration degrades gracefully.
# ───────────────────────────────────────────────────────────────

# ---- Frontend (Vite, must be prefixed VITE_) ----
# Data backend: "local" (browser localStorage, default) or "http" (API server)
VITE_DATA_BACKEND=local
# Base URL for the API server. Empty = same origin (/api). e.g. http://localhost:8787
VITE_API_BASE=
# Feature flags
VITE_FEATURE_AI=true
VITE_FEATURE_PAYMENTS=true
VITE_FEATURE_CROSSBORDER=true
# Default USD→INR for the cross-border calculator until a live rate is wired
VITE_DEFAULT_USDINR=86
# Require login (auth). Auto-on when VITE_DATA_BACKEND=http. Set 'true' to force.
VITE_REQUIRE_AUTH=false

# ---- API server (server/index.js) ----
PORT=8787
CORS_ORIGIN=http://localhost:5173

# AI assistant proxy (fixes the broken client-side widget)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAX_TOKENS=600

# Razorpay payments (Payment Links / Orders / Webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cross-border / FIRA partners (optional — enable auto-FIRA)
SKYDO_API_KEY=
WISE_API_TOKEN=

# State store dir for the legacy file backend (dev only; superseded by the DB)
STATE_DIR=

# ---- Auth + Database (v2 enterprise foundation) ----
# Secret used to sign session JWTs. MUST be a long random value in production.
JWT_SECRET=
# The v2 foundation runs on Node's built-in SQLite (dev/test, zero install).
# A Postgres adapter is included (server/db/index.js → createPostgresDb); turning
# it on is a documented async swap — see SETUP.md "Moving to Postgres".
# DATABASE_URL=postgres://user:pass@host:5432/freelanceos
DATABASE_URL=
# Override the SQLite file location (dev). Default: server/.data/freelanceos.sqlite
SQLITE_PATH=

# ---- Phase 1a: teams, billing & account security ----
# Public base URL used to build invite / email-verify / password-reset links.
APP_BASE_URL=http://localhost:5173
# Razorpay Subscriptions: create one subscription plan per paid tier in the
# Razorpay dashboard and paste its plan id here. WITHOUT these (or without the
# Razorpay keys above), POST /api/billing/checkout runs in clearly-flagged
# TEST MODE so the product stays fully explorable locally.
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_TEAM=
# Transactional email (invites, verification, reset): the default transport logs
# to the server console (dev/test, zero setup). Wire a real provider — SMTP /
# Resend / SES — via setTransport() in server/lib/mailer.js for production.
